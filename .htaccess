# IE-Photo-WEB — Apache security config

# ── Session cookie hardening ────────────────────────────────────────────────
php_value session.cookie_httponly  1
php_value session.cookie_samesite  Strict
# เปิด secure flag เฉพาะเมื่อใช้ HTTPS (production)
# php_value session.cookie_secure   1

# ── Session fixation: ใช้ strict mode ────────────────────────────────────────
php_value session.use_strict_mode  1
php_value session.use_only_cookies 1

# ── Prevent session ID in URL ─────────────────────────────────────────────────
php_value session.use_trans_sid    0

# ── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options   "nosniff"
    Header always set X-Frame-Options          "SAMEORIGIN"
    Header always set Referrer-Policy          "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection         "1; mode=block"
</IfModule>

# ── Protect sensitive directories ─────────────────────────────────────────────
<FilesMatch "\.(env|log|sql|md|json|lock)$">
    Require all denied
</FilesMatch>

# ── Prevent directory listing ─────────────────────────────────────────────────
Options -Indexes

# ── Protect config & includes from direct access ──────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/     - [F,L]
    RewriteRule ^includes/   - [F,L]
</IfModule>
