# IE-Photo-WEB — Apache security config
# NOTE: php_value directives are NOT used here because CleverCloud (and most
# modern hosts) run PHP-FPM rather than mod_php.  Session hardening settings
# are applied directly in PHP code (config/database.php) instead.

# ── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options   "nosniff"
    Header always set X-Frame-Options          "SAMEORIGIN"
    Header always set Referrer-Policy          "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection         "1; mode=block"
</IfModule>

# ── Protect sensitive directories ─────────────────────────────────────────────
<FilesMatch "\.(env|log|sql|md|json|lock)$">
    Require all denied
</FilesMatch>

# ── Prevent directory listing ─────────────────────────────────────────────────
Options -Indexes

# ── Protect config & includes from direct access ──────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/     - [F,L]
    RewriteRule ^includes/   - [F,L]
</IfModule>
